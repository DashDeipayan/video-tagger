      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DeepStream SDK would replace this whole block",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DeepStream SDK would replace this whole block",
      "lineHeight": 1.25
    },
    {
      "id": "lbl038",
      "type": "text",
      "x": 576,
      "y": 668,
      "width": 386.88,
      "height": 178.75,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 279172787,
      "version": 1,
      "versionNonce": 260573196,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "NVDEC hardware decode \u2192 nvstreammux batching \u2192\nTensorRT inference, all of it GPU-resident.\n\nKills the frames-to-disk round trip: ~1.8B JPEG\nwrites + reads per month, gone.\n\nPublishes to Kafka via nvmsgbroker, so the SAME\nvideo.tagged contract holds \u2014 ingest, search and\ntaxonomy never learn anything changed.\n\nCost: NVIDIA-only; decode+inference re-couple.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NVDEC hardware decode \u2192 nvstreammux batching \u2192\nTensorRT inference, all of it GPU-resident.\n\nKills the frames-to-disk round trip: ~1.8B JPEG\nwrites + reads per month, gone.\n\nPublishes to Kafka via nvmsgbroker, so the SAME\nvideo.tagged contract holds \u2014 ingest, search and\ntaxonomy never learn anything changed.\n\nCost: NVIDIA-only; decode+inference re-couple.",
      "lineHeight": 1.25
    },
    {
      "id": "lbl039",
      "type": "text",
      "x": 60,
      "y": 420,
      "width": 379.44,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1329753548,
      "version": 1,
      "versionNonce": 1914012529,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2500\u2500\u2500 solid pink  =  Kafka topic (named on the arrow)\n\u2500\u2500\u2500 dashed violet =  cached snapshot, polled\n\u2500\u2500\u2500 solid grey/teal =  storage read/write",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2500\u2500\u2500 solid pink  =  Kafka topic (named on the arrow)\n\u2500\u2500\u2500 dashed violet =  cached snapshot, polled\n\u2500\u2500\u2500 solid grey/teal =  storage read/write",
      "lineHeight": 1.25
    },
