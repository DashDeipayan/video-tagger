      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE NUMBER THAT DRIVES EVERYTHING",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE NUMBER THAT DRIVES EVERYTHING",
      "lineHeight": 1.25
    },
    {
      "id": "lbl043",
      "type": "text",
      "x": 84,
      "y": 910,
      "width": 590.24,
      "height": 70.0,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 721762279,
      "version": 1,
      "versionNonce": 502922617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1,000,000 hr/mo \u00f7 30 \u00f7 24  =  1,389 hr of video per wall-clock hour\nevery frame @30fps         =  41,667 inferences/sec   X  impossible\n1 frame every 2 seconds    =     694 inferences/sec   \u2713  ~1 GPU\nstorage 450 MB/hr          =  450 TB/mo \u2192 5.4 PB/yr  \u2190 the real cost",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1,000,000 hr/mo \u00f7 30 \u00f7 24  =  1,389 hr of video per wall-clock hour\nevery frame @30fps         =  41,667 inferences/sec   X  impossible\n1 frame every 2 seconds    =     694 inferences/sec   \u2713  ~1 GPU\nstorage 450 MB/hr          =  450 TB/mo \u2192 5.4 PB/yr  \u2190 the real cost",
      "lineHeight": 1.25
    },
